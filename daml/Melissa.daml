module Melissa where

import Data
import DA.Assert ((===))
import DA.List (dedup)
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Optional (fromOptional)

template Melissa
  with
    issuer    : Party
    auditor   : Party
    approvers : [Party]
    threshold : Int
    name      : Text
    assets    : Map Party [Token]
  where
    signatory issuer, approvers
    observer  auditor
    
    ensure (length . dedup) approvers >= threshold
    
    key (issuer, name) : (Party, Text)
    maintainer key._1
    
    nonconsuming choice BalanceOf : [Token]
      with owner : Party
      controller owner
        do return $ fromOptional [] $ Map.lookup owner assets
    
    choice Transfer : ContractId Melissa
      with
        proposal : ContractId TransferProposal
        executor : Party
      controller executor
        do
          approval <- fetch proposal
          approval.vault === self
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) approval.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) approval.approvers >= threshold
          
          assertMsg "Invalid Asset"
            $ any (\(owner, tokens) ->
                owner == approval.from && any (\token ->
                  token.name == approval.asset.name &&
                  token.amount >= approval.asset.amount
                ) tokens
              ) $ Map.toList assets
          
          archive proposal
          
          let tokensToMap = foldr (\token ->
                  Map.insertWith (+) token.name token.amount
                ) Map.empty
              
              tokensToList adjust = filter (\token ->
                  token.amount > 0.0
                ) . map (\(name, amount) ->
                  if name == approval.asset.name
                    then Token with
                      name
                      amount = adjust amount approval.asset.amount
                    else Token with
                      name
                      amount
                ) . Map.toList
              
              f adjust tokens =
                if Map.member approval.asset.name tokensMap
                  then tokensToList adjust tokensMap
                  else map (\(name, amount) ->
                      Token with name, amount
                    ) $ Map.toList $ Map.insert
                      approval.asset.name
                      approval.asset.amount
                      tokensMap
                where tokensMap = tokensToMap tokens
          
          create this
            with assets =
                  Map.filter (not . null) $
                  
                  -- debit
                  Map.alter (\tokens ->
                    case tokens of
                      Some tokens -> Some $ f (+) tokens
                      None        -> Some [approval.asset]
                  ) approval.to $
                  
                  -- credit
                  Map.alter (Some . f (-) =<<) approval.from assets
    
    choice AddApprover : ContractId Melissa
      with
        proposal : ContractId AddApproverProposal
        executor : Party
      controller executor
        do
          approval <- fetch proposal
          approval.vault === self
          
          assertMsg "Already Registered"
            $ approval.approver `notElem` approvers
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) approval.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) approval.approvers >= threshold
          
          archive proposal
          
          create this
            with approvers = approval.approver :: approvers
    
    choice RemoveApprover : ContractId Melissa
      with
        proposal : ContractId RemoveApproverProposal
        executor : Party
      controller executor
        do
          approval <- fetch proposal
          approval.vault === self
          
          assertMsg "Already Unregistered"
            $ approval.approver `elem` approvers
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) approval.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) approval.approvers >= threshold
          
          archive proposal
          
          create this
            with approvers = filter (/= approval.approver) approvers

template TransferProposal
  with
    vault     : ContractId Melissa
    asset     : Token
    from      : Party
    to        : Party
    auditor   : Party
    approvers : [Party]
  where
    signatory to, approvers
    observer  auditor
    
    ensure asset.amount > 0.0
    
    choice TransferProposal_Approve : ContractId TransferProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers, assets } <- fetch vault
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Invalid Asset"
            $ any (\(owner, tokens) ->
                owner == from && any (\token ->
                  token.name == asset.name &&
                  token.amount >= asset.amount
                ) tokens
              ) $ Map.toList assets
          
          create this
            with approvers = approver :: this.approvers
    
    choice TransferProposal_Cancel : ()
      controller to
        do return ()

template AddApproverProposal
  with
    vault     : ContractId Melissa
    approver  : Party
    approvers : [Party]
    proposer  : Party
    auditor   : Party
  where
    signatory proposer, approvers
    observer  auditor
    
    choice AddApproverProposal_Approve : ContractId AddApproverProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers } <- fetch vault
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Already Registered"
            $ this.approver `notElem` approvers
          
          create this
            with approvers = approver :: this.approvers
    
    choice AddApproverProposal_Cancel : ()
      controller proposer
        do return ()

template RemoveApproverProposal
  with
    vault     : ContractId Melissa
    approver  : Party
    approvers : [Party]
    proposer  : Party
    auditor   : Party
  where
    signatory proposer, approvers
    observer  auditor
    
    choice RemoveApproverProposal_Approve : ContractId RemoveApproverProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers } <- fetch vault
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Already Unregistered"
            $ this.approver `elem` approvers
          
          create this
            with approvers = approver :: this.approvers
    
    choice RemoveApproverProposal_Cancel : ()
      controller proposer
        do return ()
