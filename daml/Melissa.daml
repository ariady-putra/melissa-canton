module Melissa where

import Data
import DA.Assert ((===))
import DA.List (dedup)
import DA.Map qualified as Map

template Melissa
  with
    issuer    : Party
    owner     : Party
    auditor   : Party
    approvers : [Party]
    threshold : Int
    assets    : [Token]
  where
    signatory issuer, owner, approvers
    observer  auditor
    
    ensure (length . dedup) approvers >= threshold && not (null assets)
    
    choice Transfer : (Optional (ContractId Melissa), ContractId Melissa)
      with
        asset    : Token
        to       : Party
        approval : ContractId TransferProposal
      controller to
        do
          proposal <- fetch approval
          
          proposal.from  === self
          proposal.asset === asset
          proposal.to    === to
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) proposal.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) proposal.approvers >= threshold
          
          assertMsg "Invalid Asset"
            $ any (\token ->
                token.name == asset.name && token.amount >= asset.amount
              ) assets
          
          archive approval
          
          let leftover = filter (\token ->
                  token.amount > 0.0
                ) $ map (\(name, amount) ->
                  Token with name, amount = amount - asset.amount
                ) $ Map.toList $ foldr (\token ->
                  Map.insertWith (+) token.name token.amount
                ) Map.empty assets
          
          l <- if null leftover
                then pure None
                else Some <$> create this
                  with assets = leftover
          
          r <- create this
            with
              owner  = to
              assets = [asset]
          
          return (l ,r)
    
    choice AddApprover : ContractId Melissa
      with
        proposal : ContractId AddApproverProposal
        executor : Party
      controller executor
        do
          approval <- fetch proposal
          approval.to === self
          
          assertMsg "Already Registered"
            $ approval.approver `notElem` approvers
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) approval.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) approval.approvers >= threshold
          
          archive proposal
          
          create this
            with approvers = approval.approver :: approvers
    
    choice RemoveApprover : ContractId Melissa
      with
        proposal : ContractId RemoveApproverProposal
        executor : Party
      controller executor
        do
          approval <- fetch proposal
          approval.from === self
          
          assertMsg "Already Unregistered"
            $ approval.approver `elem` approvers
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) approval.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) approval.approvers >= threshold
          
          archive proposal
          
          create this
            with approvers = filter (/= approval.approver) approvers

template TransferProposal
  with
    from      : ContractId Melissa
    asset     : Token
    to        : Party
    auditor   : Party
    approvers : [Party]
  where
    signatory to, approvers
    observer  auditor
    
    ensure asset.amount > 0.0
    
    choice TransferProposal_Approve : ContractId TransferProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers, assets } <- fetch from
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Invalid Asset"
            $ any (\token ->
                token.name == asset.name && token.amount >= asset.amount
              ) assets
          
          create this
            with approvers = approver :: this.approvers
    
    choice TransferProposal_Cancel : ()
      controller to
        do return ()

template AddApproverProposal
  with
    to        : ContractId Melissa
    approver  : Party
    approvers : [Party]
    proposer  : Party
    auditor   : Party
  where
    signatory proposer, approvers
    observer  auditor
    
    choice AddApproverProposal_Approve : ContractId AddApproverProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers } <- fetch to
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Already Registered"
            $ this.approver `notElem` approvers
          
          create this
            with approvers = approver :: this.approvers
    
    choice AddApproverProposal_Cancel : ()
      controller approver
        do return ()

template RemoveApproverProposal
  with
    from      : ContractId Melissa
    approver  : Party
    approvers : [Party]
    proposer  : Party
    auditor   : Party
  where
    signatory proposer, approvers
    observer  auditor
    
    choice RemoveApproverProposal_Approve : ContractId RemoveApproverProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers } <- fetch from
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Already Unregistered"
            $ this.approver `elem` approvers
          
          create this
            with approvers = approver :: this.approvers
    
    choice RemoveApproverProposal_Cancel : ()
      controller proposer
        do return ()
