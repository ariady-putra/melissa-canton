module Melissa where

import Data
import DA.Assert ((===))
import DA.List (dedup)
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Optional (fromOptional)

template Melissa
  with
    issuer    : Party
    auditor   : Party
    approvers : [Party]
    threshold : Int
    name      : Text
    assets    : Map Party [Token]
  where
    signatory issuer, approvers
    observer  auditor
    
    ensure (length . dedup) approvers >= threshold
    
    key (issuer, name) : (Party, Text)
    maintainer key._1
    
    nonconsuming choice BalanceOf : [Token]
      with owner : Party
      controller owner
        do return $ fromOptional [] $ Map.lookup owner assets
    
    choice Transfer : ContractId Melissa
      with
        proposal : ContractId TransferProposal
        executor : Party -- ^ Beneficiary
      controller executor
        do
          permit <- fetch proposal
          
          permit.vault === self
          permit.to    === executor
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) permit.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) permit.approvers >= threshold
          
          assertMsg "Invalid Asset"
            $ any (\(owner, tokens) ->
                owner == permit.from && any (\token ->
                  token.name == permit.asset.name &&
                  token.amount >= permit.asset.amount
                ) tokens
              ) $ Map.toList assets
          
          proposal `exercise` TransferProposal_Archive
          
          let tokensToMap = foldr (\token ->
                  Map.insertWith (+) token.name token.amount
                ) Map.empty
              
              tokensToList adjust = filter (\token ->
                  token.amount > 0.0
                ) . map (\(name, amount) ->
                  if name == permit.asset.name
                    then Token with
                      name
                      amount = adjust amount permit.asset.amount
                    else Token with
                      name
                      amount
                ) . Map.toList
              
              f adjust tokens =
                if Map.member permit.asset.name tokensMap
                  then tokensToList adjust tokensMap
                  else map (\(name, amount) ->
                      Token with name, amount   -- convert to Token
                    ) $ Map.toList $ Map.insert -- convert to list
                      permit.asset.name   -- key
                      permit.asset.amount -- value
                      tokensMap
                where tokensMap = tokensToMap tokens
          
          create this
            with assets =
                  Map.filter (not . null) $
                  
                  -- debit
                  Map.alter (\tokens ->
                    case tokens of
                      Some tokens -> Some $ f (+) tokens
                      None        -> Some [permit.asset]
                  ) permit.to $
                  
                  -- credit
                  Map.alter (Some . f (-) =<<) permit.from assets
    
    choice AddApprover : ContractId Melissa
      with
        proposal : ContractId AddApproverProposal
        executor : Party -- ^ New approver
      controller executor
        do
          permit <- fetch proposal
          
          permit.vault    === self
          permit.approver === executor
          
          assertMsg "Already Registered"
            $ permit.approver `notElem` approvers
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) permit.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) permit.approvers >= threshold
          
          proposal `exercise` AddApproverProposal_Archive
          
          create this
            with approvers = permit.approver :: approvers
    
    choice RemoveApprover : ContractId Melissa
      with
        proposal : ContractId RemoveApproverProposal
        executor : Party -- ^ Proposer
      controller executor
        do
          permit <- fetch proposal
          
          permit.vault    === self
          permit.proposer === executor
          
          assertMsg "Already Unregistered"
            $ permit.approver `elem` approvers
          
          assertMsg "Invalid Approver(s)"
            $ all (`elem` approvers) permit.approvers
          
          assertMsg "Insufficient Approvals"
            $ (length . dedup) permit.approvers >= threshold
          
          archive proposal
          
          create this
            with approvers = filter (/= permit.approver) approvers

template TransferProposal
  with
    vault     : ContractId Melissa
    asset     : Token
    from      : Party
    to        : Party
    auditor   : Party
    approvers : [Party]
  where
    signatory from, approvers
    observer  to, auditor
    
    ensure asset.amount > 0.0
        && from /= to
    
    choice TransferProposal_Approve : ContractId TransferProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers, assets } <- fetch vault
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Invalid Asset"
            $ any (\(owner, tokens) ->
                owner == from && any (\token ->
                  token.name == asset.name &&
                  token.amount >= asset.amount
                ) tokens
              ) $ Map.toList assets
          
          create this
            with approvers = approver :: this.approvers
    
    choice TransferProposal_Cancel : ()
      controller from
        do return ()
    
    choice TransferProposal_Archive : ()
      controller to
        do return ()

template AddApproverProposal
  with
    vault     : ContractId Melissa
    approver  : Party -- ^ The new approver to be added
    approvers : [Party]
    proposer  : Party
    auditor   : Party
  where
    signatory proposer, approvers
    observer  approver, auditor
    
    choice AddApproverProposal_Approve : ContractId AddApproverProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers } <- fetch vault
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Already Registered"
            $ this.approver `notElem` approvers
          
          create this
            with approvers = approver :: this.approvers
    
    choice AddApproverProposal_Cancel : ()
      controller proposer
        do return ()
    
    choice AddApproverProposal_Archive : ()
      controller approver
        do return ()

template RemoveApproverProposal
  with
    vault     : ContractId Melissa
    approver  : Party -- ^ The existing approver to be removed
    approvers : [Party]
    proposer  : Party
    auditor   : Party
  where
    signatory proposer, approvers
    observer  approver, auditor
    
    choice RemoveApproverProposal_Approve : ContractId RemoveApproverProposal
      with approver : Party
      controller approver
        do
          assertMsg "Already Approved"
            $ approver `notElem` approvers
          
          Melissa { approvers } <- fetch vault
          
          assertMsg "Unregistered Approver"
            $ approver `elem` approvers
          
          assertMsg "Already Unregistered"
            $ this.approver `elem` approvers
          
          create this
            with approvers = approver :: this.approvers
    
    choice RemoveApproverProposal_Cancel : ()
      controller proposer
        do return ()
    
    -- choice RemoveApproverProposal_Archive : ()
    --   controller approver
    --     do return ()
