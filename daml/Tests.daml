module Tests where

import Melissa
import Data
import DA.Assert ((===), assertEq)
import DA.Map qualified as Map
import Daml.Script

coin : Decimal -> Token
coin amount = Token with name = "COIN", amount

nft : Token
nft = Token with name = "NFT", amount = 1.0

setup : Script [Party]
setup = mapA
  (allocatePartyByHint . PartyIdHint)
  [ "Issuer"
  , "Alice"
  , "Bob"
  , "Auditor"
  , "Approver1"
  , "Approver2"
  , "Approver3"
  ]

testProposeTransfer : Script ()
testProposeTransfer = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert alice's balance
  Some disclosure <- issuer `queryDisclosure` melissa
  (actAs alice <> disclose disclosure) `submit` do
    melissa `exerciseCmd` BalanceOf
      with owner = alice
    >>= assertEq [coin 100.0]
  
  -- alice creates a transfer proposal
  proposal <- alice `submit` do
    createCmd TransferProposal
      with
        vault     = melissa
        asset     = coin 20.00
        from      = alice
        to        = bob
        auditor
        approvers = []
  
  -- approver1 approves
  Some disclosure <- alice `queryDisclosure` proposal
  proposal <- (actAs approver1 <> disclose disclosure) `submit` do
    proposal `exerciseCmd` TransferProposal_Approve
      with approver = approver1
  
  -- approver2 approves
  Some disclosure <- alice `queryDisclosure` proposal
  proposal <- (actAs approver2 <> disclose disclosure) `submit` do
    proposal `exerciseCmd` TransferProposal_Approve
      with approver = approver2
  
  -- bob executes transfer
  Some disclosure <- issuer `queryDisclosure` melissa
  melissa <- (actAs bob <> disclose disclosure) `submit` do
    melissa `exerciseCmd` Transfer
      with proposal, executor = bob
  
  -- assert alice's balance
  Some disclosure <- issuer `queryDisclosure` melissa
  (actAs alice <> disclose disclosure) `submit` do
    melissa `exerciseCmd` BalanceOf
      with owner = alice
    >>= assertEq [coin 80.0]
  
  -- assert bob's balance
  Some disclosure <- issuer `queryDisclosure` melissa
  (actAs bob <> disclose disclosure) `submit` do
    melissa `exerciseCmd` BalanceOf
      with owner = bob
    >>= assertEq [coin 20.0]
  
  return ()

testProposeAddApprover : Script ()
testProposeAddApprover = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- issuer `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer]
        threshold = 1
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer]
  
  -- issuer creates an add approver proposal
  proposal <- issuer `submit` do
    createCmd AddApproverProposal
      with
        vault     = melissa
        approver  = approver1
        approvers = []
        proposer  = issuer
        auditor
  
  -- issuer approves
  approval <- issuer `submit` do
    proposal `exerciseCmd` AddApproverProposal_Approve
      with approver = issuer
  
  -- approver1 executes add approver
  Some disclosure <- issuer `queryDisclosure` melissa
  melissa <- (actAs approver1 <> disclose disclosure) `submit` do
    melissa `exerciseCmd` AddApprover
      with
        proposal = approval
        executor = approver1
  
  -- assert updated approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [approver1, issuer]
  
  return ()

testProposeRemoveApprover : Script ()
testProposeRemoveApprover = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer, approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer, approver1, approver2, approver3]
  
  -- approver1 creates a remove approver proposal
  proposal <- approver1 `submit` do
    createCmd RemoveApproverProposal
      with
        vault     = melissa
        approver  = approver2
        approvers = []
        proposer  = approver1
        auditor
  
  -- issuer approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` RemoveApproverProposal_Approve
      with approver = issuer
  
  -- approver3 approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs approver3 <> disclose disclosure) `submit` do
    proposal `exerciseCmd` RemoveApproverProposal_Approve
      with approver = approver3
  
  -- approver1 executes remove approver
  melissa <- approver1 `submit` do
    melissa `exerciseCmd` RemoveApprover
      with proposal, executor = approver1
  
  -- assert updated approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer, approver1, approver3]
  
  return ()

testProposeSetThreshold : Script ()
testProposeSetThreshold = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer, approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial threshold
  Some Melissa { threshold } <- issuer `queryContractId` melissa
  threshold === 2
  
  -- approver1 creates a set threshold proposal
  proposal <- approver1 `submit` do
    createCmd SetThresholdProposal
      with
        vault     = melissa
        threshold = 3
        approvers = []
        proposer  = approver1
        auditor
  
  -- issuer approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = issuer
  
  -- approver2 approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs approver2 <> disclose disclosure) `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = approver2
  
  -- approver1 executes remove approver
  melissa <- approver1 `submit` do
    melissa `exerciseCmd` SetThreshold
      with proposal, executor = approver1
  
  -- assert updated threshold
  Some Melissa { threshold } <- issuer `queryContractId` melissa
  threshold === 3
  
  return ()
