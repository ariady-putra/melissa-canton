module Utils where

import Data
import Daml.Script

coin : Decimal -> Token
coin amount = Token with name = "COIN", amount

nft : Text -> Token
nft name = Token with name, amount = 1.0

setup : Script [Party]
setup = mapA
  (allocatePartyByHint . PartyIdHint)
  [ "Issuer"
  , "Alice"
  , "Bob"
  , "Auditor"
  , "Approver1"
  , "Approver2"
  , "Approver3"
  ]
