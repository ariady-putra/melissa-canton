  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` RemoveApproverProposal_Approve
      with approver = issuer
  
  -- approver3 approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs approver3 <> disclose disclosure) `submit` do
    proposal `exerciseCmd` RemoveApproverProposal_Approve
      with approver = approver3
  
  -- approver1 executes remove approver
  melissa <- approver1 `submit` do
    melissa `exerciseCmd` RemoveApprover
      with proposal, executor = approver1
  
  -- assert updated approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer, approver1, approver3]
  
  -- approver3 creates a remove approver proposal
  proposal <- approver3 `submit` do
    createCmd RemoveApproverProposal
      with
        vault     = melissa
        approver  = approver1
        approvers = []
        proposer  = approver3
        auditor
  
  -- approver3 approves
  proposal <- approver3 `submit` do
    proposal `exerciseCmd` RemoveApproverProposal_Approve
      with approver = approver3
  
  -- issuer approves
  Some disclosure <- approver3 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
