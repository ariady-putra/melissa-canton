module Tests.AddApprover where

import Melissa
import Utils
import Daml.Script
import DA.Assert (assertEq, (===))
import DA.Map qualified as Map

testProposeAddApprover : Script ()
testProposeAddApprover = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- issuer `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer]
        threshold = 1
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer]
  
  -- issuer creates an add approver proposal
  proposal <- issuer `submit` do
    createCmd AddApproverProposal
      with
        vault     = melissa
        approver  = approver1
        approvers = [issuer]
        proposer  = issuer
        auditor
  
  -- approver1 executes add approver
  Some disclosure <- issuer `queryDisclosure` melissa
  melissa <- (actAs approver1 <> disclose disclosure) `submit` do
    melissa `exerciseCmd` AddApprover
      with proposal, executor = approver1
  
  -- assert updated approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [approver1, issuer]
  
  return ()

testProposeAddApprover_AddAnotherApprover : Script ()
testProposeAddApprover_AddAnotherApprover = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- issuer `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer]
        threshold = 1
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer]
  
  -- issuer creates an add approver proposal
  proposal <- issuer `submit` do
    createCmd AddApproverProposal
      with
        vault     = melissa
        approver  = approver1
        approvers = [issuer]
        proposer  = issuer
        auditor
  
  -- approver1 executes add approver
  Some disclosure <- issuer `queryDisclosure` melissa
  melissa <- (actAs approver1 <> disclose disclosure) `submit` do
    melissa `exerciseCmd` AddApprover
      with proposal, executor = approver1
  
  -- assert updated approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [approver1, issuer]
  
  -- approver1 creates an add approver proposal
  proposal <- approver1 `submit` do
    createCmd AddApproverProposal
      with
        vault     = melissa
        approver  = approver2
        approvers = [approver1]
        proposer  = approver1
        auditor
  
  -- issuer approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  approval <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` AddApproverProposal_Approve
      with approver = issuer
  
  -- approver2 executes add approver
  Some disclosure <- issuer `queryDisclosure` melissa
  melissa <- (actAs approver2 <> disclose disclosure) `submit` do
    melissa `exerciseCmd` AddApprover
      with
        proposal = approval
        executor = approver2
  
  -- assert updated approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [approver2, approver1, issuer]
  
  return ()

-- Negative Cases

testProposeAddApprover_Negative_AlreadyApproved : Script ()
testProposeAddApprover_Negative_AlreadyApproved = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- issuer `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer]
        threshold = 1
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer]
  
  -- issuer creates an add approver proposal
  proposal <- issuer `submit` do
    createCmd AddApproverProposal
      with
        vault     = melissa
        approver  = approver1
        approvers = [issuer]
        proposer  = issuer
        auditor
  
  -- issuer tries to approve the proposal
  issuer `submitMustFail` do
    proposal `exerciseCmd` AddApproverProposal_Approve
      with approver = issuer
  
  -- issuer cancels the proposal
  issuer `submit` do
    proposal `exerciseCmd` AddApproverProposal_Cancel
  
  -- assert proposal is archived
  length <$> query @AddApproverProposal issuer
    >>= assertEq 0
  
  return ()

testProposeAddApprover_Negative_UnregisteredApprover : Script ()
testProposeAddApprover_Negative_UnregisteredApprover = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- issuer `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer]
        threshold = 1
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial approver(s)
  Some Melissa { approvers } <- issuer `queryContractId` melissa
  approvers === [issuer]
  
  -- issuer creates an add approver proposal
  proposal <- issuer `submit` do
    createCmd AddApproverProposal
      with
        vault     = melissa
        approver  = approver1
        approvers = [issuer]
        proposer  = issuer
        auditor
  
  -- auditor tries to approve
  auditor `submitMustFail` do
    proposal `exerciseCmd` AddApproverProposal_Approve
      with approver = auditor
  
  -- issuer cancels the proposal
  issuer `submit` do
    proposal `exerciseCmd` AddApproverProposal_Cancel
  
  -- assert proposal is archived
  length <$> query @AddApproverProposal issuer
    >>= assertEq 0
  
  return ()

