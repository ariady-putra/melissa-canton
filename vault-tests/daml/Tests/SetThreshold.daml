module Tests.SetThreshold where

import Melissa
import Utils
import Daml.Script
import DA.Assert (assertEq)
import DA.Map qualified as Map

testProposeSetThreshold : Script ()
testProposeSetThreshold = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer, approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial threshold
  Some Melissa {
    threshold = 2
  } <- issuer `queryContractId` melissa
  
  -- approver1 creates a set threshold proposal
  proposal <- approver1 `submit` do
    createCmd SetThresholdProposal
      with
        vault     = melissa
        threshold = 3
        approvers = [approver1]
        proposer  = approver1
        auditor
  
  -- issuer approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = issuer
  
  -- approver1 executes set threshold
  melissa <- approver1 `submit` do
    melissa `exerciseCmd` SetThreshold
      with proposal, executor = approver1
  
  -- assert updated threshold
  Some Melissa {
    threshold = 3
  } <- issuer `queryContractId` melissa
  
  return ()

testProposeSetThreshold_Negative_ThresholdIsGtApprovers : Script ()
testProposeSetThreshold_Negative_ThresholdIsGtApprovers = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer, approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial threshold
  Some Melissa {
    threshold = 2
  } <- issuer `queryContractId` melissa
  
  -- approver1 creates a set threshold proposal
  proposal <- approver1 `submit` do
    createCmd SetThresholdProposal
      with
        vault     = melissa
        threshold = 5
        approvers = [approver1]
        proposer  = approver1
        auditor
  
  -- issuer approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = issuer
  
  -- approver1 executes set threshold
  approver1 `submitMustFail` do
    melissa `exerciseCmd` SetThreshold
      with proposal, executor = approver1
  
  -- assert threshold NOT updated
  Some (_, Melissa {
    threshold = 2
  }) <- issuer `queryByKey` (issuer, "Vault 101")
  
  -- approver1 cancels the proposal
  approver1 `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Cancel
  
  -- assert proposal is archived
  length <$> query @SetThresholdProposal approver1
    >>= assertEq 0
  
  return ()

testProposeSetThreshold_Negative_AlreadyApproved : Script ()
testProposeSetThreshold_Negative_AlreadyApproved = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer, approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial threshold
  Some Melissa {
    threshold = 2
  } <- issuer `queryContractId` melissa
  
  -- approver1 creates a set threshold proposal
  proposal <- approver1 `submit` do
    createCmd SetThresholdProposal
      with
        vault     = melissa
        threshold = 3
        approvers = [approver1]
        proposer  = approver1
        auditor
  
  -- issuer approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  proposal <- (actAs issuer <> disclose disclosure) `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = issuer
  
  -- issuer re-approves
  Some disclosure <- approver1 `queryDisclosure` proposal
  (actAs issuer <> disclose disclosure) `submitMustFail` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = issuer
  
  -- approver1 cancels the proposal
  approver1 `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Cancel
  
  -- assert proposal is archived
  length <$> query @SetThresholdProposal approver1
    >>= assertEq 0
  
  return ()

testProposeSetThreshold_Negative_UnregisteredApprover : Script ()
testProposeSetThreshold_Negative_UnregisteredApprover = script do
  [issuer,
   alice,
   bob,
   auditor,
   approver1,
   approver2,
   approver3] <- setup
  
  -- init vault
  melissa <- [issuer, approver1, approver2, approver3] `submit` do
    createCmd Melissa
      with
        issuer
        auditor
        approvers = [issuer, approver1, approver2, approver3]
        threshold = 2
        name      = "Vault 101"
        assets    = Map.fromList [(alice, [coin 100.00])]
  
  -- assert initial threshold
  Some Melissa {
    threshold = 2
  } <- issuer `queryContractId` melissa
  
  -- approver1 creates a set threshold proposal
  proposal <- approver1 `submit` do
    createCmd SetThresholdProposal
      with
        vault     = melissa
        threshold = 3
        approvers = [approver1]
        proposer  = approver1
        auditor
  
  -- auditor tries to approve
  Some disclosure <- approver1 `queryDisclosure` proposal
  (actAs auditor <> disclose disclosure) `submitMustFail` do
    proposal `exerciseCmd` SetThresholdProposal_Approve
      with approver = auditor
  
  -- approver1 cancels the proposal
  approver1 `submit` do
    proposal `exerciseCmd` SetThresholdProposal_Cancel
  
  -- assert proposal is archived
  length <$> query @SetThresholdProposal approver1
    >>= assertEq 0
  
  return ()

